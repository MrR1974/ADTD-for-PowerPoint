<Page x:Class="Adtd.App.Views.StylePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Adtd.App"
      Title="{l:S Nav_Style}"
      ScrollViewer.CanContentScroll="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,32" MaxWidth="1100" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:S Style_Title}" />
      <TextBlock Style="{StaticResource PageIntro}" Text="{l:S Style_Intro}" />

      <!-- Template -->
      <ui:Card>
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{l:S Style_TemplateTitle}" />
          <TextBlock Style="{StaticResource Body}" Text="{l:S Style_NoTemplate}" Visibility="{Binding HasTemplate, Converter={StaticResource Hidden}}" />
          <StackPanel Visibility="{Binding HasTemplate, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding TemplateName}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding TemplateDetails}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon FolderOpen24}" Content="{l:S Style_ChooseTemplate}" Command="{Binding BrowseTemplateCommand}" Margin="0,0,8,0" />
            <ui:Button Appearance="Secondary" Content="{l:S Style_ClearTemplate}" Command="{Binding ClearTemplateCommand}"
                       Visibility="{Binding HasTemplate, Converter={StaticResource Visible}}" />
          </StackPanel>
          <ui:InfoBar Margin="0,12,0,0" Severity="Error" IsClosable="False" Title="" Message="{Binding TemplateError}"
                      IsOpen="{Binding TemplateError, Converter={StaticResource IsSet}, Mode=OneWay}" />
          <CheckBox Margin="0,12,0,0" Content="{Binding ExistingSlidesText}" IsChecked="{Binding KeepExistingSlides}"
                    Visibility="{Binding HasExistingSlides, Converter={StaticResource Visible}}" />
        </StackPanel>
      </ui:Card>

      <!-- Layout -->
      <ui:Card Margin="0,16,0,0" Visibility="{Binding HasTemplate, Converter={StaticResource Visible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:S Style_LayoutTitle}" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:S Style_LayoutIntro}" Margin="0,0,0,10" />
            <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" DisplayMemberPath="Display" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding ContentSource}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding SectionLayoutText}" />
          </StackPanel>
          <Border Grid.Column="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left">
            <Image Source="{Binding Wireframe}" MaxHeight="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
        </Grid>
      </ui:Card>

      <!-- Theme -->
      <ui:Card Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{l:S Style_ThemeTitle}" />
          <TextBlock Style="{StaticResource Caption}" Text="{l:S Style_ThemeIntro}" Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding Swatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,12,8" Width="78" ToolTip="{Binding Hex}">
                  <Border Height="36" CornerRadius="4" Background="{Binding Brush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" Margin="0,4,0,0" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding Hex}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="{Binding FontsText}" />
        </StackPanel>
      </ui:Card>

      <!-- Icon -->
      <ui:Card Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="96" Height="96" CornerRadius="6" Background="White" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Image Source="{Binding IconImage}" Margin="10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:S Style_IconTitle}" />
            <TextBlock Style="{StaticResource Body}" Text="{Binding IconName}" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:S Style_IconIntro}" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Image24}" Content="{l:S Style_ChooseIcon}" Command="{Binding BrowseIconCommand}" Margin="0,0,8,0" />
              <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowReset24}" Content="{l:S Style_DefaultIconButton}" Command="{Binding DefaultIconCommand}"
                         Visibility="{Binding IsDefaultIcon, Converter={StaticResource Hidden}}" />
            </StackPanel>
            <ui:InfoBar Margin="0,12,0,0" Severity="Error" IsClosable="False" Title="" Message="{Binding IconError}"
                        IsOpen="{Binding IconError, Converter={StaticResource IsSet}, Mode=OneWay}" />
            <ItemsControl ItemsSource="{Binding IconWarnings}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True" Title="" Message="{Binding}" Margin="0,0,0,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</Page>
