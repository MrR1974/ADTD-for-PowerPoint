<Page x:Class="Adtd.App.Views.ExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Adtd.App"
      Title="{l:S Nav_Export}"
      ScrollViewer.CanContentScroll="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,32" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:S Export_Title}" />
      <TextBlock Style="{StaticResource PageIntro}" Text="{l:S Export_Intro}" />

      <ui:Card>
        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{l:S Export_Path}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}" Content="{l:S Common_Browse}" Command="{Binding BrowseCommand}" />
          </Grid>
          <CheckBox Margin="0,12,0,0" Content="{l:S Export_OpenWhenDone}" IsChecked="{Binding OpenWhenDone}" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon DocumentArrowRight24}" Content="{l:S Export_Button}" Command="{Binding ExportCommand}" Margin="0,0,12,0" />
            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Visibility="{Binding IsExporting, Converter={StaticResource Visible}}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding Blocker}" Visibility="{Binding Blocker, Converter={StaticResource VisibleIfSet}}" />
        </StackPanel>
      </ui:Card>

      <ItemsControl ItemsSource="{Binding Report}" Margin="0,16,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:InfoBar IsOpen="True" IsClosable="False" Title="" Message="{Binding Text}" Severity="{Binding Level, Converter={StaticResource Severity}}" Margin="0,0,0,8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Visibility="{Binding LastOutput, Converter={StaticResource VisibleIfSet}}">
        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Open24}" Content="{l:S Export_Open}" Command="{Binding OpenOutputCommand}" Margin="0,0,8,0" />
        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Folder24}" Content="{l:S Export_ShowInFolder}" Command="{Binding ShowOutputCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
