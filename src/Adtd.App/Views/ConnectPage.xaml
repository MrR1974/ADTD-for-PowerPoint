<Page x:Class="Adtd.App.Views.ConnectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Adtd.App"
      Title="{l:S Nav_Forest}"
      ScrollViewer.CanContentScroll="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,32" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:S Connect_Title}" />
      <TextBlock Style="{StaticResource PageIntro}" Text="{l:S Connect_Intro}" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Collect over LDAP -->
        <ui:Card Grid.Column="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:S Connect_CollectTitle}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:S Connect_Server}" />
            <ui:TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:S Connect_ServerHint}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding LocatedText}"
                       Visibility="{Binding LocatedText, Converter={StaticResource VisibleIfSet}}" />

            <CheckBox Margin="0,12,0,0" Content="{l:S Connect_OtherCredentials}" IsChecked="{Binding UseOtherCredentials}" />
            <StackPanel Margin="28,6,0,0" Visibility="{Binding UseOtherCredentials, Converter={StaticResource Visible}}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{l:S Connect_User}" />
              <ui:TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:S Connect_UserHint}" />
              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,4" Text="{l:S Connect_Password}" />
              <PasswordBox x:Name="Password" PasswordChanged="OnPasswordChanged" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{l:S Connect_PasswordNote}" />
            </StackPanel>

            <CheckBox Margin="0,10,0,0" Content="{l:S Connect_ResolveAddresses}" IsChecked="{Binding ResolveAddresses}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="{l:S Connect_Collect}" Command="{Binding CollectCommand}" Margin="0,0,8,0" />
              <ui:Button Appearance="Secondary" Content="{l:S Connect_Validate}" Command="{Binding ValidateCommand}" Margin="0,0,8,0" />
              <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Dismiss24}" Content="{l:S Common_Cancel}" Command="{Binding CancelCommand}"
                         Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            </StackPanel>
            <ui:ProgressRing IsIndeterminate="True" Height="20" Width="20" Margin="0,12,0,0" HorizontalAlignment="Left"
                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
          </StackPanel>
        </ui:Card>

        <!-- Snapshots and samples -->
        <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{l:S Connect_SnapshotTitle}" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:S Connect_SnapshotIntro}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}" Content="{l:S Connect_OpenSnapshot}" Command="{Binding OpenSnapshotCommand}" Margin="0,0,8,0" />
              <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Save24}" Content="{l:S Connect_SaveSnapshot}" Command="{Binding SaveSnapshotCommand}" />
            </StackPanel>
            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon DocumentTable24}" Content="{l:S Connect_ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="0,8,0,0" />

            <TextBlock Style="{StaticResource CardTitle}" Margin="0,24,0,6" Text="{l:S Connect_SampleTitle}" />
            <TextBlock Style="{StaticResource Caption}" Text="{l:S Connect_SampleIntro}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <ComboBox ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}" MinWidth="140" Margin="0,0,8,0" />
              <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Beaker24}" Content="{l:S Connect_LoadSample}" Command="{Binding LoadSampleCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding SampleDescription}" />
          </StackPanel>
        </ui:Card>
      </Grid>

      <ui:InfoBar Margin="0,16,0,0" IsOpen="{Binding Status, Converter={StaticResource IsSet}, Mode=OneWay}" IsClosable="False"
                  Severity="{Binding StatusIsError, Converter={StaticResource ErrorSeverity}}" Title="" Message="{Binding Status}" />

      <!-- What was collected -->
      <ui:Card Margin="0,16,0,0" Visibility="{Binding HasSnapshot, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding ForestName}" Margin="0,0,0,2" />
          <TextBlock Style="{StaticResource Caption}" Text="{Binding Source}" />
          <ItemsControl ItemsSource="{Binding Counts}" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,12,12" Padding="16,10" MinWidth="120" CornerRadius="6"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Value}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Visibility="{Binding Warnings, Converter={StaticResource VisibleIfSet}}">
            <TextBlock Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="0,4,0,6" Text="{l:S Connect_CollectorWarnings}" />
            <ItemsControl ItemsSource="{Binding Warnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4" Text="{Binding StringFormat='•  {0}'}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <!-- Collection log -->
      <ui:CardExpander Margin="0,16,0,0" Header="{l:S Connect_Log}" IsExpanded="True"
                       Visibility="{Binding Log.Count, Converter={StaticResource VisibleIfSet}}">
        <ListBox ItemsSource="{Binding Log}" MaxHeight="260" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" Foreground="{Binding Level, Converter={StaticResource LogBrush}}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ui:CardExpander>
    </StackPanel>
  </ScrollViewer>
</Page>
