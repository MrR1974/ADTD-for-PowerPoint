<ui:FluentWindow x:Class="Adtd.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Adtd.App"
                 xmlns:v="clr-namespace:Adtd.App.Views"
                 Title="{l:S App_Title}" Width="1280" Height="820" MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Adtd.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{l:S App_Title}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Adtd.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>
    <ui:NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" OpenPaneLength="190"
                       IsPaneToggleVisible="True">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="{l:S Nav_Forest}" Icon="{ui:SymbolIcon Organization24}" TargetPageType="{x:Type v:ConnectPage}" />
        <ui:NavigationViewItem Content="{l:S Nav_Style}" Icon="{ui:SymbolIcon PaintBrush24}" TargetPageType="{x:Type v:StylePage}" />
        <ui:NavigationViewItem Content="{l:S Nav_Diagrams}" Icon="{ui:SymbolIcon Diagram24}" TargetPageType="{x:Type v:DiagramsPage}" />
        <ui:NavigationViewItem Content="{l:S Nav_Preview}" Icon="{ui:SymbolIcon SlideMultiple24}" TargetPageType="{x:Type v:PreviewPage}" />
        <ui:NavigationViewItem Content="{l:S Nav_Export}" Icon="{ui:SymbolIcon DocumentArrowRight24}" TargetPageType="{x:Type v:ExportPage}" />
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="{l:S Nav_About}" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type v:AboutPage}" />
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>
